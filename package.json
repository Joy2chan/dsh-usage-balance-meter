{
  "name": "dsh-usage-balance-meter",
  "version": "0.1.0",
  "description": "A DeepSeek Harness plugin that shows the connected DeepSeek API balance, per-session token usage, and an optional cost estimate. (host-side tool; UI coming later)",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./client": {
      "default": "./client/index.js"
    },
    "./typert": {
      "default": "./lib/typert.js"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "client",
    "lib/typert.js"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "dshhub": {
    "schemaVersion": 1,
    "displayName": "dsh-usage-balance-meter",
    "summary": "DeepSeek Harness usage & balance plugin: official balance, per-session token usage, optional cost estimate.",
    "categories": [
      "费用",
      "观测",
      "工具"
    ],
    "surfaces": [
      "host"
    ],
    "capabilities": {
      "provides": [
        "tool:deepseek_api_status",
        "service:usageMeter"
      ]
    },
    "compatibility": {
      "dsh": ">=0.1.0-rc.5",
      "node": ">=22"
    },
    "permissions": {
      "network": [
        "https://api.deepseek.com"
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:client": "node -e \"require('node:fs').cpSync('client/index.js','lib/client.js')\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "usage",
    "balance",
    "cost",
    "billing"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-credentials": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-home-paths": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-launch-environment": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-session-projection": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.7",
    "@deepseek-ai/schemastery": "^3.18.1",
    "zod": "^4.4.3",
    "@deepseek-ai/dsh-system-prompt": "^0.1.0-rc.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Joy2chan/dsh-usage-balance-meter.git"
  },
  "homepage": "https://github.com/Joy2chan/dsh-usage-balance-meter#readme"
}
